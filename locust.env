# Env configurations specific to the load generator.

# One of the shapes in src/loadgenerator/loadshapes.
#
# - constload: for benchmarks that require a constant rate of traffic. 
#   Amount can be specified in constload.py.
#
# - dummyload: does not actually generate any traffic, and is used for testing.
#
# - rampload: used to reach an estimate for max sustainable throughput
#   under a p99-only SLO quickly.
#
# - scaleload: meant to supply a nearly saturating load the entire test. 
#   It will never terminate, so the test must be ended manually 
#   or programatically. Meant to be used with dynamic testing to 
#   determine number of replicas.
#
# - slowload: a load shape that goes slow. Meant to be as stable and 
#   predictable as possible. For data that produces pretty latency graphs.
#
# - stable_rampload: a slightly slower version of rampload, 
#   not super reliable.
#
# - testload: like constload, but terminates when value is reached.
#
LOCUST_SHAPE=constload

# Applies to: All
# How frequently, in seconds, will locust output latency statistics?
LOCUST_CSV_INTERVAL=1

# Applies to: constload, testload
# What constant value are we ramping to?
LOCUST_CONST_USERS=5000

# Applies to: rampload, slowload, stable_rampload
# Sets how long a test can be violating quality of service before terminating.
LOCUST_WAIT_TIME=30

# Applies to: rampload, scaleload, slowload, stable_rampload
# Sets how long it takes to reach a new user count value. 
LOCUST_RAMP_DURATION=10

# Applies to: scaleload, slowload, stable_rampload
# How many p99 values should the stable_rampload shape use to calculate variance?
# Lower values => variance changes faster
LOCUST_VARIANCE_WINDOW=30

# Applies to: scaleload, slowload, stable_rampload
# If the variance of the array of p99 values is lower than this, the stable_rampload shape ramps up.
# Higher values => ramp up earlier. 
LOCUST_MAX_VARIANCE=2

# Applies to: stable_rampload.
# If p99 latency is less than this value, say we are stable.
LOCUST_STABLE_P99=25

# Applies to: rampload, slowload, stable_rampload
# When p99 latency > this value for too long, terminate.
LOCUST_MAX_TAIL=150

# Applies to: slowload
# Number of users to add per ramp up.
LOCUST_SLOWLOAD_RAMP=750