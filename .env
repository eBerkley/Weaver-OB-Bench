# Exports kv pairs as env variables into the Makefile.
# Intended to contain constants that will not frequently change between tests.

# What cores are preallocated to kubernetes runtime? ex. "1-3"
KUBE_CORES=0-2


# 1 = enable debugging messages from kubernetes / docker
VERBOSE=1

# What functionality does CheckoutService implement?
# simple_checkout: main must fetch recommendations & products
# full_checkout: CheckoutService will fetch [[]productcatalogservice.Product]s based on recommendations, which it also fetches.
CHECKOUT_FUNCTIONALITY=full_checkout

# STATIC = True Benchmark, pin processes to cores manually. 
  # Else, use scaling, pin w/ kubernetes' CPUManagerPolicy.
# INITIAL = SLO discovery
# FIXED = Height exploration
# INST_FP = Instruction Footprint Profiling
# CPU_UTIL = CPU Utilization Profiling
# ALLOC = Determining replica allocations
# CUSTOM = No env variables will be overridden by make.

# HETERO_HT= Hetero Height Allocation across fusion groups within one scheme
# specify the height at groups_height.cfg of each SCHEME dir, e.g., /release/base/colocation/microservices/groups_height.cfg
#
# NOTE: Even though we define a communication-based 
# heuristic, this is satisfied by bench_type=INITIAL. 
BENCH_TYPE=CUSTOM

# When we are collecting metrics at the end of a test, 
# How long of a timespan do we use?
FINAL_METRICS_DURATION=60s

# For Initial type, how long do we run?
INITIAL_RUNTIME=360

# How many replicas do we create of the product catalog service?
# Applies to fusion groups including it.
# Note: gets overriden by any allocation set for productcatalogservice in the cfg.
PRODUCT_CATALOG_REPLICAS=1

# Overrides LOCUST_CONST_USERS. Even though all values are equal (at time of writing), 
# all variables are provided for sake of completeness.
INITIAL_USERS=100

FIXED_USERS_RAMP=350
FIXED_USERS_RAMP_RATE=4

INST_FP_USERS=2000
CPU_UTIL_USERS=2000
STATIC_LOW_LOAD_USERS=1000

SVC_SLO_FACTOR=25.0

VERT_SCALING_UNFIXED_SCALE_THRESH=25

# Note that BENCH_TYPE=CUSTOM must be set
# Otherwise, all 5 settings will be overriden by make.
# RUNTIME_METRIC_ENABLE=true requires METRIC_ENABLE to be true, too
METRIC_ENABLE=true
RUNTIME_METRIC_ENABLE=true
TRACE_ENABLE=false
INSTFP_ENABLE=false
CPU_UTIL_ENABLE=false
VERTICAL_PROF=false

# 1:  runtime metrics will export an overview csv, but also 
#     create a set of detailed JSON files for each timestamp.
#
# 0:  runtime metrics will just export the usual overview csv.
RUNTIME_METRIC_HIGH_GRANULARITY=0