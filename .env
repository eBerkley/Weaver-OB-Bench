# Exports kv pairs as env variables into the Makefile.
# Intended to contain constants that will not frequently change between tests.

# What cores are preallocated to kubernetes runtime? ex. "1-3"
KUBE_CORES=0-2

# Docker repo that you want to pull/push images to/from.
# Must be set, or deploying will not work.
DOCKER=docker.io/eberkley

# One of rampload, multiload, dummyload, constload, stable_rampload
# rampload is used to reach an accurate p99 latency quickly.
# multiload is used to reach collect latency statistics using a load shape that is constant between runs.
# dummyload does not actually generate any traffic, and is used for testing.
# constload is for benchmarks that require a constant rate of traffic. Amount can be specified in constload.py.
# stable_rampload is used for static benchmarks.
LOCUST_SHAPE=stable_rampload

# one of the basenames in release/base/colocation
SCHEME=monolith

# 1 = enable debugging messages from kubernetes / docker
VEBOSE=1

# For the rampload shape, sets how long a test can be violating quality of service before terminating.
LOCUST_WAIT_TIME=45

# For the rampload shape, sets how long it takes to reach a new user count value. 
LOCUST_RAMP_DURATION=5

# How frequently, in seconds, will locust output latency statistics?
LOCUST_CSV_INTERVAL=1

# How many p99/p50 values should the stable_rampload shape use to calculate variance?
# Lower values => variance changes faster
LOCUST_VARIANCE_WINDOW=30

# If the variance of the array of p99/p50 values is lower than this, the stable_rampload shape ramps up.
# Higher values => ramp up earlier. 
LOCUST_MAX_VARIANCE=0.75

LOCUST_STABLE_P99=25

# 1 = pin processes to cores manually
# 0 = use scaling, pin w/ kubernetes' CPUManagerPolicy
BENCH_STATIC=1